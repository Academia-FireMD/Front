#!/bin/sh
. ~/.nvm/nvm.sh 2>/dev/null || true
cd "$(git rev-parse --show-toplevel)"
# Regla global (2026-06-20): el pre-push corre los mismos checks que el CI para
# no romper nada. Build de producción + typecheck + unitarias + E2E.
npx ng build --configuration production 2>&1 || exit 1
npx tsc -p tsconfig.app.json --noEmit 2>&1 || exit 1
npx ng test --watch=false 2>&1 || exit 1
E2E_PORT="${E2E_PORT:-4201}" npx playwright test --reporter=list 2>&1 || exit 1
